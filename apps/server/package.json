{
  "name": "@knetsec/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Knetsec_Ai 服务端：采集流水线、REST API、调度器、报告生成器",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@knetsec/shared": "*",
    "cheerio": "^1.0.0",
    "croner": "^9.1.0",
    "fast-xml-parser": "^5.2.5",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "zod": "^4.6.7",
    "undici": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
