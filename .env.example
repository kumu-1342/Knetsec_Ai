# ============================================================================
# Knetsec_Ai 环境变量示例（复制为 .env 后按需修改；.env 不会提交到 Git）
# ============================================================================

# 服务监听地址与端口（默认仅监听本机，避免把情报后台暴露到公网）
KNETSEC_HOST=127.0.0.1
KNETSEC_PORT=8787

# 运行环境：development | production
NODE_ENV=development

# 首次启动时自动创建的管理员账号（登录后请立即修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 数据目录（SQLite、报告、日志、JWT 密钥均落在此目录，默认 <仓库根>/data）
# KNETSEC_DATA_DIR=D:\Knetsec_Ai\data

# 是否启用内置调度器（off 表示只允许手动采集）
KNETSEC_SCHEDULER=on

# GitHub Token（强烈建议配置，未认证时 GitHub API 限流为 60 次/小时）
GITHUB_TOKEN=

# NVD API Key（可选，配置后 NVD 限流从 5 次/30 秒提升到 50 次/30 秒）
NVD_API_KEY=

# 可选：HTTP 代理（大陆网络访问 CNVD 等站点失败时使用，例如 http://127.0.0.1:7890）
KNETSEC_HTTP_PROXY=

# 可选：LLM 智能摘要（OpenAI 兼容接口，例如 DeepSeek）
# 也可以登录管理面板在「系统设置」中开启
KNETSEC_LLM_ENABLED=false
KNETSEC_LLM_BASE_URL=https://api.deepseek.com
KNETSEC_LLM_API_KEY=
KNETSEC_LLM_MODEL=deepseek-chat