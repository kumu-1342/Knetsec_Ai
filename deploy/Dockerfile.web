# syntax=docker/dockerfile:1.7
# ============================================================================
# Knetsec_Ai 管理面板镜像（静态构建 + nginx）
#
# 职责：编译 Vue3 面板为静态文件，由 nginx 托管，并把 /api 反向代理到 server 容器。
# 适合「面板与 API 分开容器」的部署方式；若只用单容器，可直接访问 server 的 8787
#（server 镜像内已包含 apps/web/dist）。
#
# 构建（仓库根执行）：
#   docker build -f deploy/Dockerfile.web -t knetsec-ai-web:1.0.0 .
# ============================================================================

# ---------- 阶段 1：构建前端静态资源 ----------
FROM node:24-alpine AS builder
WORKDIR /app
ENV npm_config_update_notifier=false \
    npm_config_fund=false

COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
# --ignore-scripts：根 postinstall 会提前构建 shared，此时源码还没复制，先跳过
RUN if [ -f package-lock.json ]; then npm ci --ignore-scripts; else npm install --ignore-scripts; fi

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN npm run build:shared && npm -w @knetsec/web run build

# ---------- 阶段 2：nginx 托管 ----------
FROM nginx:1.27-alpine AS runner
RUN rm -rf /usr/share/nginx/html/*
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
