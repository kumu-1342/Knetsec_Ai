# ============================================================================
# Knetsec_Ai Docker Compose 环境变量示例
# 使用：复制为 .env 后修改（本文件与 docker-compose.yml 同目录）
#   Copy-Item deploy\.env.example deploy\.env
# 注意：真正的运行参数（端口、监听地址、数据目录）由 compose 内部固定注入，
#       这里只放"需要用户改"的凭据与开关。
# ============================================================================

# 宿主机访问面板的端口（映射到 nginx 容器 80）
WEB_PORT=8000

# 首次启动自动创建的管理员账号；登录后请立即在面板修改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# GitHub Token（强烈建议）：未认证 60 次/小时，配置后 5000 次/小时
GITHUB_TOKEN=

# NVD API Key（可选）：未认证 5 次/30 秒，配置后 50 次/30 秒
NVD_API_KEY=

# 可选 HTTP 代理（大陆网络访问 CNVD 等站点失败时使用，例如 http://127.0.0.1:7890）
KNETSEC_HTTP_PROXY=

# 是否启用调度器：on / off
KNETSEC_SCHEDULER=on

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 容器时区
TZ=Asia/Shanghai

# 可选：固定 JWT 密钥（至少 16 字符）。留空则首次启动自动生成到 data/.jwt-secret
KNETSEC_JWT_SECRET=
